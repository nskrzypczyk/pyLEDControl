{
    "name": "pyLEDControl Dev",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.9.10"
        },
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.vscode-typescript-next",
                "ms-vscode.vscode-json",
                "ms-python.black-formatter"
            ]
        }
    },
    "forwardPorts": [5000],
    "postCreateCommand": "chmod +x setup_local_dev.sh && ./setup_local_dev.sh",
    "remoteUser": "vscode"
}